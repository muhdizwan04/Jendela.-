# Copy to Support/release.env and fill in. That file is gitignored.
#
# The Developer ID certificate, exactly as `security find-identity -v -p codesigning`
# prints it. Requires a paid Apple Developer Program membership; an
# "Apple Development" certificate cannot be notarised.
SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# A notarytool keychain profile, created once with:
#   xcrun notarytool store-credentials jendela \
#     --apple-id you@example.com --team-id TEAMID --password <app-specific-password>
# Use an app-specific password from appleid.apple.com, never your Apple ID password.
NOTARY_PROFILE="jendela"

# Where the built dmg will be downloaded from. Used in the update manifest.
DOWNLOAD_BASE="https://jendela.app/downloads"
