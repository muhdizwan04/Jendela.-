# Copy to server/.env — gitignored. Never commit real values.

# The Ed25519 seed that signs licences, base64, from jendela-licence-private.key.
# A leak of this mints every licence ever issued.
LICENCE_PRIVATE_KEY=

# From your payment provider's webhook settings (Lemon Squeezy or Paddle).
WEBHOOK_SECRET=

# Email delivery. Without these the sign-in link is printed to the console,
# which is enough to run the whole flow locally.
RESEND_API_KEY=
MAIL_FROM="Jendela. <hello@jendela.app>"

SITE_URL=https://jendela.app
DB_PATH=./jendela.db
PORT=8787
